# Deterministic installs and the existing supported runtime baseline.
package-lock=true
lockfile-version=3
save-exact=true
engine-strict=true

# Bound registry retries and retain certificate validation.
fetch-retries=5
fetch-timeout=60000
strict-ssl=true
fund=false
update-notifier=false

# Require an explicit install-script decision in package.json allowScripts.
strict-allow-scripts=true

# Hold ordinary resolutions for one day; narrow security exceptions are documented.
min-release-age=1
strict-peer-deps=true
