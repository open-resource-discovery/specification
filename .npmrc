# Keep dependency versions reproducible.
package-lock=true
lockfile-version=3
save-exact=true

# Enforce supported runtimes and reject peer-dependency conflicts.
engine-strict=true
strict-peer-deps=true

# Block install lifecycle scripts; required build and setup steps run explicitly.
ignore-scripts=true

# Retain explicit package decisions as a guard if scripts are manually enabled.
strict-allow-scripts=true

# Delay newly published packages before ordinary resolutions.
min-release-age=2

# Keep install output quiet, bound registry requests, and verify TLS certificates.
fetch-retries=5
fetch-timeout=60000
strict-ssl=true
fund=false
update-notifier=false
