{
  "$schema": "https://open-resource-discovery.org/spec-v1/interfaces/Document.schema.json",
  "openResourceDiscovery": "1.16",
  "description": "Tenant delta pushed independently from its static baseline",
  "baseUrl": "https://metadata.example.com/tenants/acme",
  "perspective": "system-instance-delta",
  "describedSystemType": {
    "systemNamespace": "sap.example"
  },
  "describedSystemInstance": {
    "baseUrl": "https://acme.example.com",
    "localId": "acme"
  },
  "apiResources": [
    {
      "ordId": "sap.example:apiResource:hello-api:v1",
      "title": "Hello API for ACME",
      "shortDescription": "Tenant-extended greeting API",
      "description": "The complete API Resource entry replaces the entry with the same ORD ID in the static baseline.",
      "version": "1.1.0",
      "visibility": "public",
      "releaseStatus": "active",
      "partOfPackage": "sap.example:package:push-demo:v1",
      "apiProtocol": "rest",
      "resourceDefinitions": [
        {
          "type": "openapi-v3",
          "mediaType": "application/json",
          "url": "/api/hello/openapi.json",
          "accessStrategies": [
            {
              "type": "embedded"
            }
          ]
        }
      ],
      "entryPoints": ["/api/hello"]
    }
  ],
  "definitions": {
    "/api/hello/openapi.json": "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Hello API for ACME\",\"version\":\"1.1.0\"},\"paths\":{\"/hello\":{\"get\":{\"summary\":\"Get tenant-specific greeting\",\"responses\":{\"200\":{\"description\":\"A greeting message\"}}}}}}"
  }
}
