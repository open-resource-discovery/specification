{
  "$schema": "http://json.schemastore.org/package",
  "name": "@open-resource-discovery/specification",
  "version": "1.17.0",
  "description": "Open Resource Discovery (ORD) Specification",
  "author": "Open Resource Discovery contributors",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/specification.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "License.md",
    "LICENSES/Apache-2.0.txt",
    "LICENSES/Community-Spec-1.0.txt",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/generated/spec/v1"
  ],
  "scripts": {
    "docusaurus": "docusaurus",
    "build": "npm run generate && npm run build:ts && npm run build:docusaurus",
    "clean": "node src/helper/clean.mjs",
    "build:ts": "tsc -p ./tsconfig.json",
    "build:docusaurus": "docusaurus build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "npm run build:ts && node --test dist/validation/*.test.js && npm run check:license-policy",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "deploy": "npm run build && gh-pages -d ./build",
    "pregenerate": "npm run clean",
    "generate": "npx @open-resource-discovery/spec-toolkit -c ./spec-toolkit.config.json",
    "postgenerate": "npm run build:ts && node ./dist/helper/copyGeneratedToDestination.js",
    "generate:llm-notebook": "npm run generate && node ./dist/helper/exportForNotebookLM.js",
    "check:license-policy": "node --test src/helper/checkLicensePolicy.test.mjs && node src/helper/checkLicensePolicy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "@open-resource-discovery/spec-toolkit": "0.9.1",
    "@types/node": "24.13.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "2.1.1",
    "lefthook": "2.1.16",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
