{
  "$schema": "http://json.schemastore.org/package",
  "name": "@open-resource-discovery/specification",
  "version": "1.17.2",
  "description": "Open Resource Discovery (ORD) Specification",
  "author": "SAP SE",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/specification.git"
  },
  "files": [
    "README.md",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/generated/spec/v1"
  ],
  "scripts": {
    "docusaurus": "docusaurus",
    "build": "npm run generate && npm run build:ts && npm run build:docusaurus",
    "clean": "node src/helper/clean.mjs",
    "build:ts": "tsc -p ./tsconfig.json",
    "build:docusaurus": "docusaurus build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "npm run build:ts && node --test dist/validation/*.test.js",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "deploy": "npm run build && gh-pages -d ./build",
    "generate": "npm run clean && npx @open-resource-discovery/spec-toolkit -c ./spec-toolkit.config.json && npm run build:ts && node ./dist/helper/copyGeneratedToDestination.js",
    "generate:llm-notebook": "npm run generate && node ./dist/helper/exportForNotebookLM.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "@open-resource-discovery/spec-toolkit": "0.10.0",
    "@types/node": "26.6.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "2.1.1",
    "lefthook": "2.2.3",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "core-js": false,
    "fsevents@2.3.3": false,
    "lefthook@2.2.2": false,
    "@swc/core@1.16.22": false
  },
  "publishConfig": {
    "provenance": true
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.2.0"
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "^7.1.4"
    },
    "css-minimizer-webpack-plugin": {
      "serialize-javascript": "^7.1.4"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
